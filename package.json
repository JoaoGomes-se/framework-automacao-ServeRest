{
  "name": "framework-automacao-serverest",
  "version": "1.0.0",
  "description": "Suíte de testes de automação de API ServeRest em código - Grupo QAtapimbas",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --verbose",
    "test:unit": "jest tests/unit --runInBand --verbose",
    "test:poc": "jest tests/poc --runInBand --verbose",
    "test:migration": "jest tests/migration --runInBand --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "report": "node src/helpers/logReport.js"
  },
  "keywords": [
    "qa",
    "testing",
    "serverest",
    "supertest",
    "jest"
  ],
  "author": "Equipe QAtapimbas",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0"
  }
}
